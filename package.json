{
  "name": "votingserver",
  "version": "1.0.0",
  "description": "Secure, verifiable election voting API",
  "main": "src/server.ts",
  "scripts": {
    "start": "node ./src/server.ts",
    "dev": "node --watch ./src/server.ts",
    "build": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "postinstall": "prisma skills sync || exit 0",
    "contract:emit": "prisma contract emit"
  },
  "keywords": [
    "voting",
    "election",
    "api",
    "prisma-8"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@prisma/cli-engine": "0.7.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "prisma": "^8.0.0-rc.23",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/orm-postgres": "^8.0.0-rc.11",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "temporal-polyfill": "^1.0.5"
  }
