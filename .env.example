# Copy this file to `.env` and configure your environment variables.
PORT=8000
NODE_ENV=development

# Connection string for PostgreSQL (PostgreSQL >= 15).
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# Cryptographically strong secret for signing JWT tokens (min 32 chars in production)
JWT_SECRET="replace-with-a-very-long-secret-key-at-least-32-characters"
JWT_EXPIRES_IN="1d"
