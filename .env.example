# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
JWT_SECRET="your_long_secure_jwt_secret_at_least_32_chars"
# Resend API Key for sending email verification codes
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="BallotBox <onboarding@resend.dev>"
# Toggle email verification: set to "false" to let users register and login without email verification (defaults to "true")
EMAIL_VERIFICATION="true"
